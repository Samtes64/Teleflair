# Cloudflare Worker Environment Variables Template

ENVIRONMENT=production
DEFAULT_EXPIRATION_HOURS=24
MAX_EXPIRATION_HOURS=168
MAX_UPLOAD_SIZE_BYTES=5242880

# Cloudflare Account Credentials (Used for wrangler deployments, not committed)
CLOUDFLARE_ACCOUNT_ID=placeholder_account_id
CLOUDFLARE_API_TOKEN=placeholder_api_token
